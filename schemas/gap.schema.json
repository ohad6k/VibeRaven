{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viberaven.dev/schemas/gap.schema.json",
  "title": "VibeRaven Gap Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "severity", "capability", "title", "summary", "evidence", "commands", "providerBoundary"],
  "properties": {
    "$schema": { "const": "https://viberaven.dev/schemas/gap.schema.json" },
    "schemaVersion": { "const": "v1" },
    "id": { "type": "string" },
    "severity": { "enum": ["critical", "warning", "info"] },
    "capability": { "enum": ["scaling", "security", "webhooks", "payments", "database"] },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "healPlan", "verify"],
      "properties": {
        "prompt": { "type": "string" },
        "healPlan": { "type": "string" },
        "verify": { "type": "string" }
      }
    },
    "providerBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresDashboardCheck", "reason"],
      "properties": {
        "requiresDashboardCheck": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    }
  }
}
