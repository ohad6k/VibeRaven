{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viberaven.dev/schemas/gate-result.schema.json",
  "title": "VibeRaven Gate Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "runId",
    "mode",
    "generatedAt",
    "workspace",
    "gate",
    "capabilities",
    "topGapIds",
    "artifacts",
    "commands",
    "redaction"
  ],
  "properties": {
    "$schema": { "const": "https://viberaven.dev/schemas/gate-result.schema.json" },
    "schemaVersion": { "const": "v1" },
    "runId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["scan", "verify", "strict", "agent-mode", "condense", "error"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "packageManager", "languages", "frameworks"],
      "properties": {
        "root": { "type": "string" },
        "packageManager": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "criticalCount", "warningCount", "providerBoundaryRequired"],
      "properties": {
        "status": { "enum": ["clear", "not_clear", "warning", "unknown", "error"] },
        "criticalCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "providerBoundaryRequired": { "type": "boolean" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scaling", "security", "webhooks", "payments", "database"],
      "properties": {
        "scaling": { "$ref": "#/$defs/capabilityStatus" },
        "security": { "$ref": "#/$defs/capabilityStatus" },
        "webhooks": { "$ref": "#/$defs/capabilityStatus" },
        "payments": { "$ref": "#/$defs/capabilityStatus" },
        "database": { "$ref": "#/$defs/capabilityStatus" }
      }
    },
    "topGapIds": { "type": "array", "items": { "type": "string" } },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasklist", "contextMap", "gateResult", "gapsDir", "healDir"],
      "properties": {
        "tasklist": { "type": "string" },
        "contextMap": { "type": "string" },
        "gateResult": { "type": "string" },
        "gapsDir": { "type": "string" },
        "healDir": { "type": "string" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verify", "strict", "next"],
      "properties": {
        "verify": { "type": "string" },
        "strict": { "type": "string" },
        "next": { "type": "string" },
        "promptFirstGap": { "type": "string" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "count"],
      "properties": {
        "applied": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "capabilityStatus": {
      "enum": ["clear", "warning", "critical", "unknown", "not_applicable"]
    }
  }
}
